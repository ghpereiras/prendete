VITE_API_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=
# Tiene que ser la misma VAPID_PUBLIC_KEY que configuraste en el backend (raíz del repo).
VITE_VAPID_PUBLIC_KEY=
# OAuth Client ID de Google (el mismo GOOGLE_CLIENT_ID del backend). Vacío = no se muestra "Continuar con Google".
VITE_GOOGLE_CLIENT_ID=
