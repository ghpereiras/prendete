POSTGRES_USER=prendete
POSTGRES_PASSWORD=prendete
POSTGRES_DB=prendete
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://prendete:prendete@localhost:5432/prendete

# Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# VAPID key pair for push notifications — generate it only once, see the
# README ("Backend — Setup") for the command.
VAPID_PUBLIC_KEY=changeme
VAPID_PRIVATE_KEY=changeme
VAPID_CONTACT_EMAIL=admin@example.com

# Frontend origins allowed by CORS, comma-separated (no spaces and no trailing
# slash). In production add the frontend's real URL.
CORS_ORIGINS=http://localhost:5173

# Brevo API key (https://app.brevo.com) used to send transactional emails
# (account verification, password reset).
BREVO_API_KEY=changeme
EMAIL_FROM_ADDRESS=no-reply@prendete.ar
EMAIL_FROM_NAME=Prendete

# Frontend base URL, used to build the links inside emails (verification,
# password reset). In production: https://prendete.ar
FRONTEND_URL=http://localhost:5173

# OAuth Client ID (type "Web") from Google Cloud Console for "Continue with
# Google". Authorized origins: the frontend; authorized redirect URIs:
# <frontend>/auth/google/callback. Empty = the button isn't shown.
GOOGLE_CLIENT_ID=

# Emails (comma-separated) allowed to open the /admin dashboard. They must have a verified email.
ADMIN_EMAILS=
