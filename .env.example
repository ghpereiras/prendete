POSTGRES_USER=prendete
POSTGRES_PASSWORD=prendete
POSTGRES_DB=prendete
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://prendete:prendete@localhost:5432/prendete

# Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Par de claves VAPID para push notifications — generarlas una sola vez, ver
# README ("Notificaciones push") para el comando.
VAPID_PUBLIC_KEY=changeme
VAPID_PRIVATE_KEY=changeme
VAPID_CONTACT_EMAIL=admin@example.com

# Orígenes del frontend permitidos por CORS, separados por coma (sin espacios
# ni barra final). En prod hay que agregar la URL real del frontend.
CORS_ORIGINS=http://localhost:5173

# API key de Brevo (https://app.brevo.com) para mandar emails transaccionales
# (verificación de cuenta, reset de contraseña).
BREVO_API_KEY=changeme
EMAIL_FROM_ADDRESS=no-reply@prendete.ar
EMAIL_FROM_NAME=Prendete

# Base del frontend, para armar los links que van dentro de los emails
# (verificación, reset de contraseña). En prod: https://prendete.ar
FRONTEND_URL=http://localhost:5173

# OAuth Client ID (tipo "Web") de Google Cloud Console para "Continuar con
# Google". Orígenes autorizados: el frontend; URIs de redirección autorizadas:
# <frontend>/auth/google/callback. Vacío = el botón no se muestra.
GOOGLE_CLIENT_ID=
