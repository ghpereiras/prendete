POSTGRES_USER=privento
POSTGRES_PASSWORD=privento
POSTGRES_DB=privento
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://privento:privento@localhost:5432/privento

# Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Par de claves VAPID para push notifications — generarlas una sola vez, ver
# README ("Notificaciones push") para el comando.
VAPID_PUBLIC_KEY=changeme
VAPID_PRIVATE_KEY=changeme
VAPID_CONTACT_EMAIL=admin@example.com
